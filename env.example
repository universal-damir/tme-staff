# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://lbsxtpdihjnoyskstzdz.supabase.co
# IMPORTANT: this MUST be the anon key, NOT the service_role key.
# Anything with the NEXT_PUBLIC_ prefix is inlined into the browser bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Server-only. Do not prefix with NEXT_PUBLIC_. Used by /api/storage/* routes.
SUPABASE_SERVICE_KEY=your_service_role_key_here

# TME Portal API (for triggering employee emails)
TME_PORTAL_API_URL=https://your-tme-portal-url
TME_PORTAL_API_KEY=your_api_key_here

# VAT filing upload link (/vat-files/<token>), email code (round 4 B).
# "on" = the page asks the addresses the request went to for a 6-digit code.
# Off / unset = the page opens for anyone with the link (as before).
VAT_FILES_EMAIL_CODE=
# Brevo SMTP relay login for the code email (same values as tme-sign / the portal).
# Unset in `next dev` = the code is printed in the server log instead of mailed.
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
# Optional: HMAC key for code / proof hashes. Unset = SUPABASE_SERVICE_KEY is used
# (rotating that key then ends every open proof, like tme-sign).
VAT_FILES_CODE_SECRET=
