# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://lbsxtpdihjnoyskstzdz.supabase.co
# IMPORTANT: this MUST be the anon key, NOT the service_role key.
# Anything with the NEXT_PUBLIC_ prefix is inlined into the browser bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Server-only. Do not prefix with NEXT_PUBLIC_. Used by /api/storage/* routes.
SUPABASE_SERVICE_KEY=your_service_role_key_here

# TME Portal API (for triggering employee emails)
TME_PORTAL_API_URL=https://your-tme-portal-url
TME_PORTAL_API_KEY=your_api_key_here
